#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python /app/manage.py collectstatic  --settings=config.settings.production --noinput

exec /usr/local/bin/gunicorn config.asgi --env DJANGO_SETTINGS_MODULE=config.settings.production --bind 0.0.0.0:5000 --chdir=/app -k uvicorn.workers.UvicornWorker
