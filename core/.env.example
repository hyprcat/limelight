# Copy to .env and fill in. config/settings/base.py reads this file.
# docker-compose-*.yml pass the same file to the containers.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=cloud.limelight.sh
# Path of the admin site, for example "admin/". Production requires it.
DJANGO_ADMIN_URL=
DJANGO_ADMIN_FORCE_ALLAUTH=False
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
# "yes" inside the local Docker setup, so the debug toolbar sees the gateway IP.
USE_DOCKER=no

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=limelight
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_FLOWER_USER=
CELERY_FLOWER_PASSWORD=

# S3 bucket for uploaded media, and the CloudFront distribution in front of it
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=
DJANGO_AWS_S3_REGION_NAME=
DJANGO_AWS_S3_CUSTOM_DOMAIN=
DJANGO_AWS_S3_MAX_MEMORY_SIZE=100000000
CLOUDFRONT_DOMAIN=

# The video service (../video)
VIDEO_SERVICE_URL=https://runner.limelight.sh/

# Firebase: Google sign-in and push notifications.
# The credentials file is a service account JSON key. Do not commit it.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=firebase-credentials.json

# Email (SendGrid through django-anymail)
DJANGO_EMAIL_BACKEND=
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_SERVER_EMAIL=
DJANGO_EMAIL_SUBJECT_PREFIX=
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com/v3/

# Sentry. Production requires the DSN.
SENTRY_DSN=
DJANGO_SENTRY_LOG_LEVEL=20
